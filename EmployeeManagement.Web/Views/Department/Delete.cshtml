@model EmployeeManagement.Application.DTOs.Departments.DepartmentDto

<h1>Delete Department</h1>

<h3>Are you sure you want to delete this department?</h3>

<div>
    <strong>Id:</strong>
    @Model.DepartmentId
</div>

<div>
    <strong>Name:</strong>
    @Model.Name
</div>

<div>
    <strong>Description:</strong>
    @Model.Description
</div>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden"
           name="id"
           value="@Model.DepartmentId" />

    @Html.AntiForgeryToken()

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>