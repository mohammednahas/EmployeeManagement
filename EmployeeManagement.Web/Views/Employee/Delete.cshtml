@model EmployeeManagement.Application.DTOs.Employees.EmployeeDto

<h1>Delete Employee</h1>

<h3>Are you sure you want to delete this employee?</h3>

<div>
    <p>
        <strong>Id:</strong>
        @Model.EmployeeId
    </p>

    <p>
        <strong>Name:</strong>
        @Model.Name
    </p>

    <p>
        <strong>Salary:</strong>
        @Model.Salary
    </p>

    <p>
        <strong>Department:</strong>
        @Model.DepartmentName
    </p>
</div>

<form asp-action="DeleteConfirmed" method="post">

    @Html.AntiForgeryToken()

    <input type="hidden"
           name="id"
           value="@Model.EmployeeId" />

    <button type="submit">
        Delete
    </button>

    <a asp-action="Index">
        Cancel
    </a>

</form>