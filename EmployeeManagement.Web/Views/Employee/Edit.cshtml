@model EmployeeManagement.Application.DTOs.Employees.UpdateEmployeeDto

<h1>Edit Employee</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="EmployeeId" />

    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>

    <div>
        <label asp-for="Salary"></label>
        <input asp-for="Salary" />
        <span asp-validation-for="Salary"></span>
    </div>

    <div>
        <label asp-for="DepartmentId">
            Department
        </label>

        <select asp-for="DepartmentId"
                asp-items="ViewBag.Departments">

            <option value="">
                -- Select Department --
            </option>

        </select>

        <span asp-validation-for="DepartmentId"></span>
    </div>

    <button type="submit">
        Save Changes
    </button>

</form>

<a asp-action="Index">
    Back
</a>